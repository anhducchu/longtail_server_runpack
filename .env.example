# Copy to the ignored .env.local, then fill the values below. Never commit or
# echo that local file into terminal output, W&B config, or issue trackers.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=longtail
WANDB_MODE=online

# CIFAR-100 defaults to ./data and downloads automatically.
LTX_DATA_ROOT=
LTX_REPOS_ROOT=
LTX_RUNS_ROOT=
LTX_METRICS_ROOT=

# GPU packing for the one-command runner. Leave empty for the default: all
# detected GPUs, tasks-per-GPU auto-computed from free VRAM. Equivalent to
# `scripts/run.sh --gpus ... --per-gpu ... --jobs ...`.
LTX_GPU_IDS=
LTX_TASKS_PER_GPU=
LTX_MAX_CONCURRENT=
