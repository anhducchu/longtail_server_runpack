# Copy to .env.local, then fill the values below.  For the explicitly intended
# private hand-off, .env.local may travel with the repository; never echo it
# into terminal output, W&B config, or issue trackers.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=longtail
WANDB_MODE=online

# All non-ImageNet data defaults to ./data and downloads automatically.
LTX_DATA_ROOT=
LTX_REPOS_ROOT=
LTX_RUNS_ROOT=
LTX_METRICS_ROOT=

# GPU packing for the one-command runner. Leave empty for the default: all
# detected GPUs, tasks-per-GPU auto-computed from free VRAM. Equivalent to
# `scripts/run_server.sh --gpus ... --per-gpu ... --jobs ...`.
LTX_GPU_IDS=
LTX_TASKS_PER_GPU=
LTX_MAX_CONCURRENT=

# ImageNet-LT downloads automatically by default: the runner fetches the
# official ILSVRC2012 train archive, extracts train/<synset> images, and gets
# checksum-pinned public ImageNet-LT train/val manifests.  The reference split
# must be 20 images/class (20,000 images); the runner rejects substitutes.
LTX_IMAGENET_SOURCE=auto

# Optional private-mirror override.  Use this only when the server cannot
# reach the official endpoint.  It must contain the exact train/<synset> image
# layout referenced by the manifests.  These URLs are never written to reports.
LTX_IMAGENET_ARCHIVE_URL=
LTX_IMAGENET_ARCHIVE_SHA256=
LTX_IMAGENET_ARCHIVE_FORMAT=auto
LTX_IMAGENET_ARCHIVE_STRIP_COMPONENTS=0
LTX_IMAGENET_LT_TRAIN_MANIFEST_URL=
LTX_IMAGENET_LT_TRAIN_MANIFEST_SHA256=
LTX_IMAGENET_LT_REFERENCE_MANIFEST_URL=
LTX_IMAGENET_LT_REFERENCE_MANIFEST_SHA256=

# Leave these empty for automatic download.  Set all three only when the
# recipient has already mounted the exact licensed payload.
LTX_IMAGENET_ROOT=
LTX_IMAGENET_LT_TRAIN_MANIFEST=
LTX_IMAGENET_LT_REFERENCE_MANIFEST=

# Required only for the deferred ImageNet-LT 64x64 launcher. Use `access` on
# ACCESS, or `main_complete` after every main CIFAR-100-LT row has SUCCESS + FID.
LTX_IMAGENET_LT_GATE=
