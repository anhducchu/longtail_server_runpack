# Copy to the ignored .env.local, then fill the values below. Never commit or
# echo that local file into terminal output, W&B config, or issue trackers.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=longtail
WANDB_MODE=online

# CIFAR-100 defaults to ./data and downloads automatically.
LTX_DATA_ROOT=
LTX_REPOS_ROOT=
LTX_RUNS_ROOT=
LTX_METRICS_ROOT=

# Optional preflight guards. Multi-GPU parallelism belongs to Slurm or one
# shell process per GPU; main.py itself always runs selected tasks sequentially.
LTX_MIN_FREE_GPU_GB=12
LTX_MIN_FREE_DISK_GB=20
